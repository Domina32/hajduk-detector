# Enable development behavior for commands that import the app directly
FASTAPI_ENV=development

PROJECT_NAME="Poljud Games"

# --- Secrets ---------------------------------------------------------------
# This file is TRACKED by git. The real values live in `.env.local` (gitignored)
# and override whatever is here, because Settings loads `../.env` and then
# `../.env.local` in that order. What stays below is the dev-only fallback a
# fresh clone or CI needs to boot at all:
#
#   SECRET_KEY              -> real value in .env.local
#   FIRST_SUPERUSER_PASSWORD-> real value in .env.local
#   POSTGRES_PASSWORD       -> real value HERE (docker compose interpolates it
#                              from this file; it only guards the local dev DB)
#
# Note: outside development the app refuses to start while SECRET_KEY or
# FIRST_SUPERUSER_PASSWORD are still "changethis", so a placeholder can never
# reach a deployment unnoticed.
# ---------------------------------------------------------------------------

SECRET_KEY=changethis
FIRST_SUPERUSER=hajduk-detector@protonmail.com
FIRST_SUPERUSER_PASSWORD=changethis

# Emails. Development sends are captured by Mailpit (http://localhost:8025).
# Real outbound mail needs an SMTP provider - see PLAN.md M4.
SMTP_HOST=localhost
EMAILS_FROM_EMAIL=hajduk-detector@protonmail.com
SMTP_TLS=False
SMTP_PORT=1025

# Postgres
POSTGRES_PASSWORD=6d32458e84b4e2f9e36d60760967df97d241bdbd6128e382e1f96592aeda510a
DATABASE_URL=postgresql://postgres:${POSTGRES_PASSWORD}@localhost:5432/app
