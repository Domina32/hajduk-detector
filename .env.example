# Copy this file to `.env` and fill in the real values:
#
#   cp .env.example .env
#
# `.env` is gitignored - it holds the real secrets. This template is tracked.
# The app refuses to start while SECRET_KEY, FIRST_SUPERUSER_PASSWORD or
# POSTGRES_PASSWORD is still "changethis".

PROJECT_NAME="Poljud Games"

# --- Secrets ---------------------------------------------------------------
# Generate with: openssl rand -hex 32
SECRET_KEY=changethis
FIRST_SUPERUSER=hajduk-detector@protonmail.com
FIRST_SUPERUSER_PASSWORD=changethis

# TheSportsDB free key (no account needed).
THESPORTSDB_API_KEY=123

# Emails. Development sends are captured by Mailpit (http://localhost:8025).
# Real outbound mail needs an SMTP provider - see PLAN.md M4.
SMTP_HOST=localhost
EMAILS_FROM_EMAIL=hajduk-detector@protonmail.com
SMTP_TLS=False
SMTP_PORT=1025

# Postgres
POSTGRES_PASSWORD=changethis
DATABASE_URL=postgresql://postgres:${POSTGRES_PASSWORD}@localhost:5432/app
